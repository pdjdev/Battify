<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>False</WebView2EnableCsWinRTProjection>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release;Portable</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>

    <!-- Windows 10/11 includes .NET Framework 4.8, so the MSIX package does
         not need to ship the .NET desktop runtime. -->
    <TargetFramework>net48</TargetFramework>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	  
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Title>Battify</Title>
    <PackageId>Battify</PackageId>

	<Version>1.0.3</Version>
	<AssemblyVersion>1.0.3</AssemblyVersion>
	<FileVersion>1.0.3</FileVersion>
	<InformationalVersion>1.0.3</InformationalVersion>
	  
    <Company>PBJSoftware</Company>
    <Copyright>PBJSoftware</Copyright>
    <Description>Easy-to-Use Battery Notify App for Windows Laptops</Description>
  
	<PlatformTarget>AnyCPU</PlatformTarget>
  
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\images\battify_info_banner.png" />
    <Resource Include="Resources\images\tray_guide_image.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.1" />
    <!-- Bundle managed NuGet dependencies into Battify.exe for Release builds. -->
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="AppIcon.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppIcon.resx</DependentUpon>
    </Compile>
    <Compile Update="BattIconBlack.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BattIconBlack.resx</DependentUpon>
    </Compile>
    <Compile Update="BattIconWhite.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BattIconWhite.resx</DependentUpon>
    </Compile>
    <Compile Update="DefAlertSound.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DefAlertSound.resx</DependentUpon>
    </Compile>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Keep English strings in Battify.exe instead of generating en\Battify.resources.dll. -->
    <EmbeddedResource Update="Strings.en.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>Battify.Strings.en.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="AppIcon.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppIcon.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="BattIconBlack.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>BattIconBlack.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="BattIconWhite.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>BattIconWhite.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="DefAlertSound.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DefAlertSound.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
	
</Project>
